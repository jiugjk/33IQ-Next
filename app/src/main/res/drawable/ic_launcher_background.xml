<?xml version="1.0" encoding="utf-8"?>
<!--
The launcher icon's background: the same diagonal blue gradient the source artwork uses, drawn full
bleed across the 108dp adaptive-icon canvas so every launcher mask shape stays fully covered.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:aapt="http://schemas.android.com/aapt"
        android:width="108dp"
        android:height="108dp"
        android:viewportWidth="108"
        android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF17A5FE"/>
                <item android:offset="1" android:color="#FF0563D7"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
