<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
    Saving a question image to the gallery. Android 10+ writes through MediaStore under
    scoped storage and needs no permission at all, so this is capped at API 28 - which, with
    minSdk 28, is the single version that still requires it.
    -->
    <uses-permission
            android:name="android.permission.WRITE_EXTERNAL_STORAGE"
            android:maxSdkVersion="28" />

    <!-- Resolving ACTION_VIEW https intents on targetSdk 30+ (the GitHub repo row on 我的). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!--
    Data backup:
    dataExtractionRules - API 31+
    allowBackup and fullBackupContent - API < 31
    -->
    <!--
    Predictive back: targetSdk is 35, and the system only turns this on by default from targetSdk 36.
    Navigation Compose 2.8+ seeks the NavHost pop transitions against the gesture once the activity
    has opted in; without the flag the back swipe still pops, it just jumps.
    -->
    <application
            android:name=".IqApplication"
            android:allowBackup="false"
            android:fullBackupContent="false"
            android:dataExtractionRules="@xml/data_extraction_rules"
            android:enableOnBackInvokedCallback="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@style/Theme.Iq33"
            android:usesCleartextTraffic="false">

        <activity
                android:name="com.jiugjk.iq33.app.presentation.MainActivity"
                android:exported="true"
                android:theme="@style/Theme.Iq33.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
